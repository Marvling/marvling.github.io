---
// Click-to-load iframe: nothing is requested from the third party until the button is pressed.
interface Props {
  src: string;
  label: string;
  title: string;
}
const { src, label, title } = Astro.props;
---

<div class="embed" data-src={src} data-title={title}>
  <button type="button">▶ {label}</button>
  <slot />
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('.embed')) {
    box.querySelector('button')?.addEventListener('click', (event) => {
      const iframe = document.createElement('iframe');
      iframe.src = box.dataset.src!;
      iframe.title = box.dataset.title!;
      iframe.allow = 'autoplay';
      (event.currentTarget as HTMLElement).replaceWith(iframe);
    });
  }
</script>
